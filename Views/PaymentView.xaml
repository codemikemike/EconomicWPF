<UserControl
    x:Class="EconomicWPF.Views.PaymentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Moderne Style Definitions  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD" />
                                <Setter Property="Foreground" Value="#757575" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SecondaryButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#757575" />
        </Style>

        <Style
            x:Key="DangerButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#F44336" />
        </Style>

        <Style
            x:Key="SuccessButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#212121" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="Margin" Value="0,5,0,3" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5" />
            <Setter Property="RowHeight" Value="35" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="#1976D2" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBDEFB" />
                    <Setter Property="Foreground" Value="#212121" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource HeaderText}"
                Text="Betalinger" />

            <Border
                Grid.Column="1"
                Padding="15,8"
                Background="#E8F5E9"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="#616161"
                        Text="Total betalinger" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#4CAF50"
                        Text="{Binding TotalPayments, StringFormat=C}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Filter Bar  -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DatePicker
                Grid.Column="0"
                Width="130"
                SelectedDate="{Binding DateFrom}"
                Style="{StaticResource ModernDatePicker}" />

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="#757575"
                Text="→" />

            <DatePicker
                Grid.Column="2"
                Width="130"
                SelectedDate="{Binding DateTo}"
                Style="{StaticResource ModernDatePicker}" />

            <ComboBox
                Grid.Column="4"
                Width="150"
                ItemsSource="{Binding PaymentMethods}"
                SelectedItem="{Binding PaymentMethodFilter}"
                Style="{StaticResource ModernComboBox}" />

            <Button
                Grid.Column="6"
                Command="{Binding RegisterPaymentCommand}"
                Content="➕ Registrer betaling"
                Style="{StaticResource SuccessButton}" />
        </Grid>

        <!--  Main Content Area  -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="15" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Payments List  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
                <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding PaymentDate, StringFormat=dd-MM-yyyy}"
                            Header="Dato" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Invoice.InvoiceNumber}"
                            Header="Fakturanr." />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Invoice.Customer.Name}"
                            Header="Kunde" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Amount, StringFormat=C}"
                            Header="Beløb">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#4CAF50" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding PaymentMethod}"
                            Header="Metode" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Reference}"
                            Header="Reference" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!--  Unpaid Invoices  -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="10"
                        Background="#FFEBEE"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#D32F2F"
                            Text="⚠️ Ubetalte fakturaer" />
                    </Border>

                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding UnpaidInvoices}"
                        SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding InvoiceNumber}"
                                Header="Fakturanr." />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Customer.Name}"
                                Header="Kunde" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}"
                                Header="Forfaldsdato" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding TotalAmount, StringFormat=C}"
                                Header="Beløb">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  Edit Panel  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2"
                Padding="20"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Registrer Betaling" />

                        <!--  Payment Information  -->
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="BETALINGSOPLYSNINGER" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Faktura *" />
                        <ComboBox
                            ItemsSource="{Binding UnpaidInvoices}"
                            SelectedItem="{Binding SelectedInvoice}"
                            Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Text="{Binding InvoiceNumber}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding Customer.Name}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#757575">
                                            <Run Text="Beløb: " />
                                            <Run Text="{Binding TotalAmount, StringFormat=C}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  Invoice Details (when selected)  -->
                        <Border
                            Margin="0,10,0,0"
                            Padding="15"
                            Background="#E3F2FD"
                            CornerRadius="4"
                            Visibility="{Binding SelectedInvoice, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="12"
                                    Text="Fakturabeløb:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedInvoice.TotalAmount, StringFormat=C}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    Text="Forfald:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Text="{Binding SelectedInvoice.DueDate, StringFormat=dd-MM-yyyy}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource LabelText}" Text="Betalingsdato *" />
                        <DatePicker SelectedDate="{Binding CurrentPayment.PaymentDate}" Style="{StaticResource ModernDatePicker}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Beløb *" />
                        <TextBox
                            FontSize="16"
                            FontWeight="SemiBold"
                            Style="{StaticResource ModernTextBox}"
                            Text="{Binding CurrentPayment.Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Betalingsmetode *" />
                        <ComboBox
                            ItemsSource="{Binding PaymentMethods}"
                            SelectedItem="{Binding CurrentPayment.PaymentMethod}"
                            Style="{StaticResource ModernComboBox}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Reference" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CurrentPayment.Reference, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Summary  -->
                        <Border
                            Margin="0,15,0,0"
                            Padding="15"
                            Background="#E8F5E9"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#2E7D32"
                                    Text="OPSUMMERING" />
                                <Grid>
                                    <TextBlock FontSize="12" Text="Betaling registreres på:" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding SelectedInvoice.Customer.Name}" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock FontSize="12" Text="Beløb:" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#4CAF50"
                                        Text="{Binding CurrentPayment.Amount, StringFormat=C}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Error Message  -->
                        <TextBlock
                            Margin="0,15,0,0"
                            FontWeight="SemiBold"
                            Foreground="#F44336"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!--  Action Buttons  -->
                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding SavePaymentCommand}"
                                Content="✓ Gem betaling"
                                Style="{StaticResource SuccessButton}" />
                            <Button
                                Command="{Binding CancelCommand}"
                                Content="✕ Annuller"
                                Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Bottom Action Bar  -->
        <Border
            Grid.Row="3"
            Margin="0,15,0,0"
            Padding="15"
            Background="#F5F5F5"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Command="{Binding EditPaymentCommand}"
                        Content="✏️ Rediger"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        Command="{Binding ViewPaymentHistoryCommand}"
                        Content="📜 Betalingshistorik"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Command="{Binding DeletePaymentCommand}"
                        Content="🗑️ Slet"
                        Style="{StaticResource DangerButton}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#616161"
                    Text="{Binding StatusMessage}" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        FontWeight="SemiBold"
                        Text="Total betalinger: " />
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#2196F3"
                        Text="{Binding Payments.Count}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Loading Overlay  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#99FFFFFF"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#2196F3"
                    Text="⏳ Indlæser..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>