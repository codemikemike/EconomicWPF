<UserControl
    x:Class="EconomicWPF.Views.BudgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Moderne Style Definitions  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD" />
                                <Setter Property="Foreground" Value="#757575" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SecondaryButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#757575" />
        </Style>

        <Style
            x:Key="DangerButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#F44336" />
        </Style>

        <Style
            x:Key="SuccessButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#212121" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="Margin" Value="0,5,0,3" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5" />
            <Setter Property="RowHeight" Value="35" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="#1976D2" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBDEFB" />
                    <Setter Property="Foreground" Value="#212121" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource HeaderText}"
                Text="Budgetter" />

            <Border
                Grid.Column="1"
                Padding="15,8"
                Background="#E3F2FD"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="#616161"
                        Text="Total Budget" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#2196F3"
                        Text="{Binding TotalBudget, StringFormat=C}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Filter Bar  -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                Width="100"
                ItemsSource="{Binding Years}"
                SelectedItem="{Binding SelectedYear}"
                Style="{StaticResource ModernComboBox}" />

            <ComboBox
                Grid.Column="2"
                Width="150"
                ItemsSource="{Binding Months}"
                SelectedItem="{Binding SelectedMonth}"
                Style="{StaticResource ModernComboBox}" />

            <Button
                Grid.Column="4"
                Command="{Binding NewBudgetCommand}"
                Content="➕ Nyt Budget"
                Style="{StaticResource SuccessButton}" />
        </Grid>

        <!--  Main Content Area  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Budgets List  -->
            <Border
                Grid.Column="0"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
                <DataGrid ItemsSource="{Binding Budgets}" SelectedItem="{Binding SelectedBudget, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding BudgetName}"
                            Header="Budgetnavn" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding Account.AccountName}"
                            Header="Konto" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Year}"
                            Header="År" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding MonthName}"
                            Header="Måned" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Amount, StringFormat=C}"
                            Header="Beløb">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Variance, StringFormat=C}"
                            Header="Afvigelse">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Variance, Converter={StaticResource PositiveNegativeConverter}}" Value="Positive">
                                            <Setter Property="Foreground" Value="#4CAF50" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Variance, Converter={StaticResource PositiveNegativeConverter}}" Value="Negative">
                                            <Setter Property="Foreground" Value="#F44336" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!--  Edit Panel  -->
            <Border
                Grid.Column="2"
                Padding="20"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Budget Detaljer" />

                        <!--  Budget Information  -->
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="BUDGETOPLYSNINGER" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Budgetnavn *" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CurrentBudget.BudgetName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Konto *" />
                        <ComboBox
                            ItemsSource="{Binding Accounts}"
                            SelectedItem="{Binding SelectedAccount}"
                            Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding AccountNumber}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding AccountName}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  Periode  -->
                        <TextBlock
                            Margin="0,15,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="PERIODE" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}" Text="År *" />
                                <ComboBox
                                    ItemsSource="{Binding Years}"
                                    SelectedItem="{Binding CurrentBudget.Year}"
                                    Style="{StaticResource ModernComboBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelText}" Text="Måned *" />
                                <ComboBox
                                    ItemsSource="{Binding MonthNumbers}"
                                    SelectedItem="{Binding CurrentBudget.Month}"
                                    Style="{StaticResource ModernComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource MonthNumberToNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!--  Beløb  -->
                        <TextBlock
                            Margin="0,15,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="BELØB" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Budgetbeløb *" />
                        <TextBox
                            FontSize="16"
                            FontWeight="SemiBold"
                            Style="{StaticResource ModernTextBox}"
                            Text="{Binding CurrentBudget.Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Noter" />
                        <TextBox
                            Height="80"
                            AcceptsReturn="True"
                            Style="{StaticResource ModernTextBox}"
                            Text="{Binding CurrentBudget.Notes, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  Budget Analysis (if selected)  -->
                        <Border
                            Margin="0,15,0,0"
                            Padding="15"
                            Background="#E3F2FD"
                            CornerRadius="4"
                            Visibility="{Binding IsBudgetSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#1565C0"
                                    Text="ANALYSE" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="12"
                                        Text="Budget:" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding SelectedBudget.Amount, StringFormat=C}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,5,0,0"
                                        FontSize="12"
                                        Text="Faktisk:" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,5,0,0"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding ActualAmount, StringFormat=C}" />

                                    <Separator
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Text="Afvigelse:" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding SelectedBudget.Variance, StringFormat=C}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedBudget.Variance, Converter={StaticResource PositiveNegativeConverter}}" Value="Positive">
                                                        <Setter Property="Foreground" Value="#4CAF50" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedBudget.Variance, Converter={StaticResource PositiveNegativeConverter}}" Value="Negative">
                                                        <Setter Property="Foreground" Value="#F44336" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Error Message  -->
                        <TextBlock
                            Margin="0,15,0,0"
                            FontWeight="SemiBold"
                            Foreground="#F44336"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!--  Action Buttons  -->
                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding SaveBudgetCommand}"
                                Content="✓ Gem"
                                Style="{StaticResource SuccessButton}" />
                            <Button
                                Command="{Binding CancelCommand}"
                                Content="✕ Annuller"
                                Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Bottom Action Bar  -->
        <Border
            Grid.Row="3"
            Margin="0,15,0,0"
            Padding="15"
            Background="#F5F5F5"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Command="{Binding EditBudgetCommand}"
                        Content="✏️ Rediger"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        Command="{Binding AnalyzeBudgetCommand}"
                        Content="📊 Analyse"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Command="{Binding CopyToNextMonthCommand}"
                        Content="📋 Kopier til næste måned"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Command="{Binding DeleteBudgetCommand}"
                        Content="🗑️ Slet"
                        Style="{StaticResource DangerButton}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#616161"
                    Text="{Binding StatusMessage}" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        FontWeight="SemiBold"
                        Text="Total budgetter: " />
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#2196F3"
                        Text="{Binding Budgets.Count}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Loading Overlay  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#99FFFFFF"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#2196F3"
                    Text="⏳ Indlæser..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>