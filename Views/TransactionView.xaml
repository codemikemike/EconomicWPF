<UserControl
    x:Class="EconomicWPF.Views.TransactionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Moderne Style Definitions  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD" />
                                <Setter Property="Foreground" Value="#757575" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SecondaryButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#757575" />
        </Style>

        <Style
            x:Key="DangerButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#F44336" />
        </Style>

        <Style
            x:Key="SuccessButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
        </Style>

        <Style
            x:Key="WarningButton"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#FF9800" />
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#212121" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="Margin" Value="0,5,0,3" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5" />
            <Setter Property="RowHeight" Value="35" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="#1976D2" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBDEFB" />
                    <Setter Property="Foreground" Value="#212121" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource HeaderText}"
                Text="Bogføring" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Border
                    Margin="5"
                    Padding="15,8"
                    Background="#E8F5E9"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="#616161"
                            Text="Debet" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#4CAF50"
                            Text="{Binding TotalDebit, StringFormat=C}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="5"
                    Padding="15,8"
                    Background="#FFEBEE"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="#616161"
                            Text="Kredit" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#F44336"
                            Text="{Binding TotalCredit, StringFormat=C}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="5"
                    Padding="15,8"
                    Background="#E3F2FD"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="#616161"
                            Text="Balance" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#2196F3"
                            Text="{Binding Balance, StringFormat=C}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Filter Bar  -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Padding="10"
                FontSize="14"
                Style="{StaticResource ModernTextBox}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock
                Grid.Column="0"
                Padding="15,10"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="#9E9E9E"
                IsHitTestVisible="False"
                Text="🔍 Søg efter postering...">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel
                Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <CheckBox
                    Margin="0,0,15,0"
                    Content="Kun bogførte"
                    FontSize="14"
                    IsChecked="{Binding ShowPostedOnly}" />
                <CheckBox
                    Content="Kun ikke-bogførte"
                    FontSize="14"
                    IsChecked="{Binding ShowUnpostedOnly}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Command="{Binding ViewJournalCommand}"
                Content="📅 Denne måned"
                Style="{StaticResource SecondaryButton}" />

            <Button
                Grid.Column="3"
                Command="{Binding ExportJournalCommand}"
                Content="📊 Eksporter"
                Style="{StaticResource SecondaryButton}" />

            <Button
                Grid.Column="4"
                Command="{Binding NewTransactionCommand}"
                Content="➕ Ny postering"
                Style="{StaticResource SuccessButton}" />
        </Grid>

        <!--  Main Content Area  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Transactions List  -->
            <Border
                Grid.Column="0"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
                <DataGrid ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding TransactionDate, StringFormat=dd-MM-yyyy}"
                            Header="Dato" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding VoucherNumber}"
                            Header="Bilagsnr." />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Account.AccountNumber}"
                            Header="Konto" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Description}"
                            Header="Beskrivelse" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding DebitAmount, StringFormat=C}"
                            Header="Debet">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#4CAF50" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding CreditAmount, StringFormat=C}"
                            Header="Kredit">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#F44336" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn
                            Width="80"
                            Binding="{Binding IsPosted}"
                            Header="Bogført" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!--  Edit Panel  -->
            <Border
                Grid.Column="2"
                Padding="20"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Postering" />

                        <!--  Transaction Information  -->
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="POSTERINGSOPLYSNINGER" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Dato *" />
                        <DatePicker SelectedDate="{Binding CurrentTransaction.TransactionDate}" Style="{StaticResource ModernDatePicker}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Bilagsnummer" />
                        <TextBox
                            Background="#F5F5F5"
                            IsReadOnly="True"
                            Style="{StaticResource ModernTextBox}"
                            Text="{Binding CurrentTransaction.VoucherNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Konto *" />
                        <ComboBox
                            ItemsSource="{Binding Accounts}"
                            SelectedItem="{Binding SelectedAccount}"
                            Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding AccountNumber}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding AccountName}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Style="{StaticResource LabelText}" Text="Beskrivelse *" />
                        <TextBox
                            Height="60"
                            AcceptsReturn="True"
                            Style="{StaticResource ModernTextBox}"
                            Text="{Binding CurrentTransaction.Description, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  Amounts  -->
                        <TextBlock
                            Margin="0,15,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="BELØB" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}" Text="Debet" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CurrentTransaction.DebitAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelText}" Text="Kredit" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CurrentTransaction.CreditAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="#FFF3E0"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="11"
                                Foreground="#E65100"
                                Text="⚠️ Kun ét af beløbene (debet eller kredit) må være udfyldt"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  Additional Info  -->
                        <TextBlock
                            Margin="0,15,0,10"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#757575"
                            Text="YDERLIGERE OPLYSNINGER" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Faktura" />
                        <ComboBox
                            DisplayMemberPath="InvoiceNumber"
                            ItemsSource="{Binding Invoices}"
                            SelectedValue="{Binding CurrentTransaction.InvoiceId}"
                            SelectedValuePath="InvoiceId"
                            Style="{StaticResource ModernComboBox}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Projekt" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Projects}"
                            SelectedValue="{Binding CurrentTransaction.ProjectId}"
                            SelectedValuePath="ProjectId"
                            Style="{StaticResource ModernComboBox}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Dimension" />
                        <ComboBox
                            DisplayMemberPath="DimensionName"
                            ItemsSource="{Binding Dimensions}"
                            SelectedValue="{Binding CurrentTransaction.DimensionId}"
                            SelectedValuePath="DimensionId"
                            Style="{StaticResource ModernComboBox}" />

                        <!--  Error Message  -->
                        <TextBlock
                            Margin="0,15,0,0"
                            FontWeight="SemiBold"
                            Foreground="#F44336"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!--  Action Buttons  -->
                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding SaveTransactionCommand}"
                                Content="✓ Gem"
                                Style="{StaticResource SuccessButton}" />
                            <Button
                                Command="{Binding CancelCommand}"
                                Content="✕ Annuller"
                                Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Bottom Action Bar  -->
        <Border
            Grid.Row="3"
            Margin="0,15,0,0"
            Padding="15"
            Background="#F5F5F5"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Command="{Binding EditTransactionCommand}"
                        Content="✏️ Rediger"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        Command="{Binding PostTransactionCommand}"
                        Content="✅ Bogfør"
                        Style="{StaticResource SuccessButton}" />
                    <Button
                        Command="{Binding UnpostTransactionCommand}"
                        Content="↩ Annuller bogføring"
                        Style="{StaticResource WarningButton}" />
                    <Button
                        Command="{Binding DeleteTransactionCommand}"
                        Content="🗑️ Slet"
                        Style="{StaticResource DangerButton}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#616161"
                    Text="{Binding StatusMessage}" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        FontWeight="SemiBold"
                        Text="Total posteringer: " />
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#2196F3"
                        Text="{Binding Transactions.Count}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Loading Overlay  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#99FFFFFF"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#2196F3"
                    Text="⏳ Indlæser..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>