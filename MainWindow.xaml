<Window
    x:Class="EconomicWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="E-conomic WPF"
    Width="1600"
    Height="900"
    Background="#F5F5F5"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Navigation Button Style  -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Margin="5,2"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Active Navigation Button Style  -->
        <Style
            x:Key="ActiveNavButtonStyle"
            BasedOn="{StaticResource NavButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#1565C0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Bar  -->
        <Border
            Grid.Row="0"
            Height="60"
            Background="#1565C0">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.2"
                    ShadowDepth="2"
                    Color="#000000" />
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo and App Name  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Text="📊" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="E-conomic WPF" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#BBDEFB"
                            Text="Økonomistyring" />
                    </StackPanel>
                </StackPanel>

                <!--  Center Info  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Margin="10"
                        Padding="15,8"
                        Background="#1E88E5"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="📅 " />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding CurrentDate, StringFormat='dd. MMMM yyyy'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  User Info  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Padding="12,8"
                        Background="#1E88E5"
                        CornerRadius="20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Text="👤" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Administrator" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content Area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Navigation Sidebar  -->
            <Border
                Grid.Column="0"
                Background="#2196F3"
                BorderBrush="#1976D2"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!--  Dashboard Section  -->
                        <TextBlock
                            Margin="15,15,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="OVERSIGT" />

                        <Button
                            x:Name="btnDashboard"
                            Click="NavigateToDashboard"
                            Content="📊  Dashboard"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Customers & Suppliers  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="KUNDER &amp; LEVERANDØRER" />

                        <Button
                            x:Name="btnCustomers"
                            Click="NavigateToCustomers"
                            Content="👥  Kunder"
                            Style="{StaticResource NavButtonStyle}" />

                        <Button
                            x:Name="btnSuppliers"
                            Click="NavigateToSuppliers"
                            Content="🏢  Leverandører"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Products & Services  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="PRODUKTER" />

                        <Button
                            x:Name="btnProducts"
                            Click="NavigateToProducts"
                            Content="📦  Produkter"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Sales & Invoicing  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="SALG &amp; FAKTURERING" />

                        <Button
                            x:Name="btnInvoices"
                            Click="NavigateToInvoices"
                            Content="📄  Fakturaer"
                            Style="{StaticResource NavButtonStyle}" />

                        <Button
                            x:Name="btnPayments"
                            Click="NavigateToPayments"
                            Content="💰  Betalinger"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Projects & Time  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="PROJEKTER &amp; TID" />

                        <Button
                            x:Name="btnProjects"
                            Click="NavigateToProjects"
                            Content="📁  Projekter"
                            Style="{StaticResource NavButtonStyle}" />

                        <Button
                            x:Name="btnTimeEntries"
                            Click="NavigateToTimeEntries"
                            Content="⏱️  Tidsregistrering"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Accounting  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="BOGFØRING" />

                        <Button
                            x:Name="btnAccounts"
                            Click="NavigateToAccounts"
                            Content="📋  Kontoplan"
                            Style="{StaticResource NavButtonStyle}" />

                        <Button
                            x:Name="btnTransactions"
                            Click="NavigateToTransactions"
                            Content="📝  Posteringer"
                            Style="{StaticResource NavButtonStyle}" />

                        <Button
                            x:Name="btnBankTransactions"
                            Click="NavigateToBankTransactions"
                            Content="🏦  Bankafstemning"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Budget & Analysis  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="BUDGET &amp; ANALYSE" />

                        <Button
                            x:Name="btnBudgets"
                            Click="NavigateToBudgets"
                            Content="💵  Budgetter"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Settings  -->
                        <TextBlock
                            Margin="15,20,15,5"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#BBDEFB"
                            Text="INDSTILLINGER" />

                        <Button
                            x:Name="btnDimensions"
                            Click="NavigateToDimensions"
                            Content="🔖  Dimensioner"
                            Style="{StaticResource NavButtonStyle}" />

                        <Button
                            x:Name="btnVATCodes"
                            Click="NavigateToVATCodes"
                            Content="📊  Momskoder"
                            Style="{StaticResource NavButtonStyle}" />

                        <!--  Bottom spacing  -->
                        <Border Height="20" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Content Area  -->
            <Border
                Grid.Column="1"
                Padding="0"
                Background="#F5F5F5">
                <ContentControl x:Name="ContentArea" />
            </Border>
        </Grid>
    </Grid>
</Window>